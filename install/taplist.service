[Unit]
Description=Merritt House tap list (beer board web app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=TAPLIST_DATA=__APP_DIR__/data
EnvironmentFile=-__APP_DIR__/taplist.env
ExecStart=/usr/bin/python3 __APP_DIR__/app.py --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
